# Copy to .env and adjust for your machine. Never commit a real .env.
# Every value here is a local-only default or an empty placeholder: no real secrets.

# --- Database ---------------------------------------------------------------
# Used by docker-compose.yml to create the local PostgreSQL container.
POSTGRES_DB=support
POSTGRES_USER=support
POSTGRES_PASSWORD=support
POSTGRES_PORT=5432
# Used by the app (SQLAlchemy + psycopg 3). Must match the values above.
DATABASE_URL=postgresql+psycopg://support:support@localhost:5432/support

# --- Model configuration ----------------------------------------------------
# Gemini API free tier (Q4 decided). Get a free key from Google AI Studio; do not link billing.
# LLM_MODEL is a Flash model ID, pinned at W2.9 from the current free-tier list.
# LLM_PROVIDER can be switched to a local model (e.g. ollama) if the free quota runs out.
LLM_PROVIDER=gemini
LLM_MODEL=
LLM_API_KEY=
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
# Retries per model request for rate limits (429), 5xx and timeouts, with backoff.
LLM_MAX_RETRIES=2
# What the W5 comparisons vary (W2.16): single (W2.9 baseline) or specialist (W2.10), and
# the prompt files used (app/agents/prompts/<name>_<version>.md).
AGENT_ARCHITECTURE=specialist
AGENT_PROMPT_VERSION=v1
# Hard limits per workflow run (HLD 5b: "excessive workflow loops"): model calls plus tool
# calls, and tokens. They hold across pauses.
MAX_WORKFLOW_STEPS=25
MAX_RUN_TOKENS=50000

# --- Embedding configuration ------------------------------------------------
# Local sentence-transformers model stored in pgvector (Q3 decided). No API key needed.
# EMBEDDING_DIMENSIONS must match the policy_chunks.embedding vector(N) column.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# --- Authentication ---------------------------------------------------------
# Locally signed HS256 JWTs for demo customers and reviewers (Q5 decided).
# Use a long random value (32+ bytes) in your own .env; this placeholder is for local dev only.
JWT_SECRET=change-me-local-dev-only-32-bytes-min
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# --- Mock external services -------------------------------------------------
# Ports are used by docker-compose.yml; URLs are used by the app.
MOCK_PAYMENTS_PORT=8001
MOCK_PAYMENTS_URL=http://localhost:8001
# API keys are sent as X-API-Key; they stay on the server and are never given to the model.
MOCK_PAYMENTS_API_KEY=mock-payments-local-key
MOCK_SHIPPING_PORT=8002
MOCK_SHIPPING_URL=http://localhost:8002
MOCK_SHIPPING_API_KEY=mock-shipping-local-key
MOCK_TICKETING_PORT=8003
MOCK_TICKETING_URL=http://localhost:8003
MOCK_TICKETING_API_KEY=mock-ticketing-local-key
# Per-request timeout (seconds) for the app's calls to the mock services.
PROVIDER_TIMEOUT_SECONDS=5

# --- Store ------------------------------------------------------------------
# One store, one currency (Q6 decided). Amounts are stored in minor units (paise).
STORE_CURRENCY=INR

# --- Human approval ---------------------------------------------------------
# A pending approval expires after this many minutes and must be requested again.
APPROVAL_EXPIRY_MINUTES=60

# --- Run execution (W3.13) --------------------------------------------------
# inline: the API drives each run inside the request (simple local use, tests).
# worker: the API queues a job and answers 202 Accepted; start the worker with
#   uv run python -m app.jobs.worker   (or: docker compose --profile worker up -d)
RUN_EXECUTION=inline
